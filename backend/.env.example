# ── LLM & AI Services ──────────────────────────────────────────────────────
# Copy this file to backend/.env and fill in your real keys (never commit .env)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
COHERE_API_KEY=your-cohere-api-key
SERPER_API_KEY=your-serper-api-key
# Seconds before an LLM call is abandoned, and how many times it is retried
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./lexmind.db

# ── Vector Store ────────────────────────────────────────────────────────────
CHROMA_PERSIST_PATH=./chroma_db

# ── Security & CORS ─────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
# Leave empty for local dev (disables API-key middleware).
# Set a strong random value in production and match VITE_API_KEY on the frontend.
SECRET_KEY=

# ── File Upload ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50

# ── Logging & tracing ──────────────────────────────────────────────────────
# text (readable) or json (one JSON object per line, for log aggregators)
LOG_FORMAT=text
LOG_LEVEL=INFO
# Optional LangSmith tracing of every LLM call / LangGraph run
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=lexmind-ai
